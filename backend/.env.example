# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored — never commit real secrets.

# Server
PORT=5000
NODE_ENV=development
# Origins allowed to call the API directly (comma separated).
# In dev the Vite proxy makes the API same-origin, so this is mostly for production.
# NOTE: a bare "*" is always rejected. Host wildcards (https://*.example.com)
# are also rejected unless you explicitly opt in below — a pattern such as
# https://*.vercel.app would trust every Vercel deployment in existence.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# CORS_ALLOW_WILDCARD=true

# Set when running behind a reverse proxy (nginx, Apache, load balancer)
# so rate limiting sees the real client IP, e.g.: TRUST_PROXY=loopback or 1.
# On Vercel this defaults to 1 automatically (process.env.VERCEL is set),
# so you only need to set it for other proxies.
TRUST_PROXY=

# PostgreSQL
# Option A (recommended): one connection string
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# (on Neon use the *pooled* endpoint — the host that contains "-pooler")
# Option B: individual settings (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=webai
# Set to true for hosted databases that require TLS (Neon, Supabase, RDS, ...)
PG_SSL=false
# Connections per serverless instance — keep this small (1-3) on Vercel/Neon
DB_POOL_MAX=10
# Set to true on Vercel once the tables exist (created via the Neon SQL editor)
SKIP_SCHEMA_INIT=false

# Auth — generate a long random value, e.g.: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Session cookie (httpOnly — the JWT is never readable from page JavaScript).
# Production defaults: Secure + SameSite=None (required when the frontend runs
# on a different origin); development defaults to SameSite=Lax without Secure.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_MAX_AGE_DAYS=7

# Comma separated emails allowed to read the usage analytics and the
# contact-message inbox (GET /api/admin/contact-messages)
ADMIN_EMAILS=

# Password reset codes are valid for this many minutes
RESET_TOKEN_TTL_MINUTES=30
# Frontend origin used to build password-reset links
APP_URL=http://localhost:5173

# SMTP (password reset emails). Leave empty in development — the reset code is
# printed to the server console instead. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Feature Kit <no-reply@example.com>"

# Third-party AI keys — server side only, never exposed to the browser
STABILITY_API_KEY=
REMOVE_BG_API_KEY=
HUGGINGFACE_API_KEY=

# Rate limiting ------------------------------------------------------------
# Defaults are fine for a demo. Rate-limit counters live in memory per
# process, which on Vercel means every cold instance starts fresh — set the
# two Upstash variables below to share one counter across all instances
# (free tier: https://upstash.com, Redis REST API, no extra npm package).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL=300
# RATE_LIMIT_CREDENTIALS=60
# RATE_LIMIT_CONTACT=5
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI=20

# Logging: debug | info | warn | error (one JSON object per line)
# LOG_LEVEL=info
