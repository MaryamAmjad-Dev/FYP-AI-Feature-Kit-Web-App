# Copy this file to frontend/.env only if the backend is NOT served under the
# same origin as the frontend (in dev the Vite proxy handles /api automatically).
#
# Examples:
#   VITE_API_URL=/api                                 # default, uses the dev proxy
#   VITE_API_URL=https://your-api.vercel.app/api      # deployed backend on Vercel
# (on Vercel: set VITE_API_URL to the backend project's URL + /api in
#  Project Settings -> Environment Variables, then redeploy)
VITE_API_URL=

# SECURITY: never put API keys (Stability, remove.bg, Hugging Face, ...) in the
# frontend. Every VITE_* variable is compiled into the public JS bundle and can
# be read by anyone in the browser. Those keys belong in backend/.env.
